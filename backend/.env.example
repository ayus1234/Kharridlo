# ==============================================================================
# Kharridlo Backend - Environment Configuration
# ==============================================================================

APP_NAME=Kharridlo API
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/dhankriya

# AI Engine Credentials
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_API_KEY_2=

# Razorpay Test Mode API Credentials
# NOTE: Use TEST MODE credentials only (key_id begins with 'rzp_test_').
# Secrets must NEVER be committed to version control.
# The public key ID is safely exposed to frontend checkout.
# The key secret and webhook secret must strictly remain server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# Marketplace Integration Credentials (Milestone 9)
# ==============================================================================
# Amazon Creators API (Amazon.in) - Uses OAuth 2.0 Client Credentials
AMAZON_CREATORS_API_ENABLED=false
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_REGION=eu-west-1
AMAZON_HOST=creatorsapi.amazon
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_TOKEN_ENDPOINT=https://api.amazon.co.uk/auth/o2/token

# Flipkart Affiliate API / Feed
FLIPKART_API_ENABLED=false
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_API_BASE_URL=https://affiliate-api.flipkart.net/affiliate/1.0

# Future Infrastructure Placeholders
REDIS_URL=
