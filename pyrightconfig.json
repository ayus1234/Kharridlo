{
  "venvPath": "backend",
  "venv": ".venv",
  "extraPaths": [
    "backend",
    "backend/.venv/Lib/site-packages"
  ],
  "exclude": [
    "**/__pyrefly_virtual__/**",
    "**/__pycache__/**",
    "**/.venv/**"
  ],
  "reportMissingImports": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownVariableType": "none"
}
